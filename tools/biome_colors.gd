extends SceneTree
## Writes game/world/biome_colors.gd: the average colour of every V1 ground tile (src/assets/tiles,
## variants 0..3, only opaque pixels), so the 3D ground keeps the colours of the V1 tiles.
##
##   godot --headless -s tools/biome_colors.gd

const TILES := "res://src/assets/tiles"
const OUTPUT := "res://game/world/biome_colors.gd"


func _initialize() -> void:
	# src/assets carries a .gdignore, so the files are read from disk, not as resources.
	var folder := ProjectSettings.globalize_path(TILES)
	var lines := PackedStringArray([
		"class_name BiomeColors",
		"extends RefCounted",
		"## Average colours of the V1 ground tiles per biome and variant (0..3). Generated by",
		"## tools/biome_colors.gd from src/assets/tiles — do not edit by hand.",
		"",
		"const FALLBACK := Color(0.45, 0.45, 0.42)",
		"",
		"const TABLE := {",
	])
	var biomes := DirAccess.get_directories_at(folder)
	biomes.sort()
	for biome: String in biomes:
		var colors := PackedStringArray()
		for variant: int in 4:
			var path := "%s/%s/%s_%d.webp" % [folder, biome, biome, variant]
			var color := _average(path)
			colors.append("Color(%.3f, %.3f, %.3f)" % [color.r, color.g, color.b])
		lines.append('\t"%s": [%s],' % [biome.to_upper(), ", ".join(colors)])
	lines.append("}")
	lines.append("")
	lines.append("")
	lines.append("## Colour of a biome (upper-case key) in one of its variants.")
	lines.append("static func of(biome: String, variant: int) -> Color:")
	lines.append("\tvar colors: Array = TABLE.get(biome, [])")
	lines.append("\tif colors.is_empty():")
	lines.append("\t\treturn FALLBACK")
	lines.append("\tvar color: Color = colors[clampi(variant, 0, colors.size() - 1)]")
	lines.append("\treturn color")
	lines.append("")
	lines.append("")
	lines.append("## Mean colour of a biome over its variants.")
	lines.append("static func mean(biome: String) -> Color:")
	lines.append("\tvar colors: Array = TABLE.get(biome, [])")
	lines.append("\tif colors.is_empty():")
	lines.append("\t\treturn FALLBACK")
	lines.append("\tvar sum := Color(0, 0, 0, 0)")
	lines.append("\tfor color: Color in colors:")
	lines.append("\t\tsum += color")
	lines.append("\treturn sum / colors.size()")
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("wrote %d biomes to %s" % [biomes.size(), OUTPUT])
	quit()


func _average(path: String) -> Color:
	var image := Image.load_from_file(path)
	if image == null or image.is_empty():
		return Color(0.45, 0.45, 0.42)
	image.resize(64, 32, Image.INTERPOLATE_BILINEAR)
	var sum := Vector3.ZERO
	var count := 0.0
	for y: int in image.get_height():
		for x: int in image.get_width():
			var pixel := image.get_pixel(x, y)
			if pixel.a > 0.9:
				sum += Vector3(pixel.r, pixel.g, pixel.b)
				count += 1.0
	if count == 0.0:
		return Color(0.45, 0.45, 0.42)
	sum /= count
	return Color(sum.x, sum.y, sum.z)
