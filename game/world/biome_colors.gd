## Colour of a biome (upper-case key) in one of its variants.
static func of(biome: String, variant: int) -> Color:
	var colors: Array = TABLE.get(biome, [])
	if colors.is_empty():
		return FALLBACK
	var color: Color = colors[clampi(variant, 0, colors.size() - 1)]
	return color


## Mean colour of a biome over its variants.
static func mean(biome: String) -> Color:
	var colors: Array = TABLE.get(biome, [])
	if colors.is_empty():
		return FALLBACK
	var sum := Color(0, 0, 0, 0)
	for color: Color in colors:
		sum += color
	return sum / colors.size()
